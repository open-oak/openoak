ACCOUNT_ISSUER_URL="https://account.openoak.org"
ACCOUNT_JWKS_URL="https://account.openoak.org/api/auth/jwks"
ACCOUNT_DATABASE_URL="postgresql://...openoak-account-db..."
ACCOUNT_DATABASE_SCHEMA="public"

# PostgreSQL transport: loopback URLs default to plaintext; remote URLs default
# to certificate and hostname verification. Use these only for a custom policy.
# POSTGRES_SSL_MODE="verify-full"
# POSTGRES_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"


OUTLINE_DATABASE_URL="postgresql://...outline-app-db..."
OUTLINE_DATABASE_SCHEMA="public"
KANBAN_DATABASE_URL="postgresql://...kanban-app-db..."
KANBAN_DATABASE_SCHEMA="public"
TODO_DATABASE_URL="postgresql://...todo-app-db..."
TODO_DATABASE_SCHEMA="public"

MCP_RESOURCE_URL="https://mcp.openoak.org"
MCP_ALLOWED_HOSTS="mcp.openoak.org"
MCP_ALLOWED_ORIGINS="https://chatgpt.com,https://claude.ai,https://vscode.dev,https://cursor.com"
MCP_RATE_LIMIT_MODE="observe"
MCP_READ_RATE_LIMIT_PER_MINUTE="240"
MCP_WRITE_RATE_LIMIT_PER_MINUTE="90"
OUTLINE_PUBLIC_URL="https://outline.openoak.org"
KANBAN_PUBLIC_URL="https://kanban.openoak.org"
TODO_PUBLIC_URL="https://todo.openoak.org"

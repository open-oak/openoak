{
  "name": "@openoak/kanban",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "exports": {
    "./mcp": "./lib/mcp.ts",
    "./mcp-v2": "./lib/mcp-v2.ts"
  },
  "scripts": {
    "dev": "next dev",
    "generate": "prisma generate --schema prisma/central.prisma && prisma generate --schema prisma/kanban.prisma",
    "migrate": "prisma migrate dev --config prisma.config.ts",
    "migrate:deploy": "prisma migrate deploy --config prisma.config.ts",
    "build": "npm run generate && next build",
    "build:vercel": "node ../../scripts/vercel-build.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:migration": "node tests/integration/kanban-migration.test.mjs",
    "test:operations": "node tests/integration/kanban-operations.test.mjs",
    "test:browser-sync": "node tests/integration/kanban-browser.test.mjs",
    "migration:shadow": "node scripts/kanban-shadow.mjs",
    "migration:cutover": "node scripts/kanban-cutover.mjs",
    "test:sharing": "node --test tests/integration/kanban-sharing.test.mjs",
    "test:sharing-ui": "node tests/integration/kanban-sharing-ui.test.mjs",
    "test:ui": "node tests/integration/kanban-ui.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "better-auth": "1.7.19",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "next": "16.4.6",
    "pg": "8.22.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "^3.5.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "8.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prisma": "7.9.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "playwright": "1.62.1",
    "@axe-core/playwright": "4.13.0"
  },
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}

# Required: one PostgreSQL database for outlines and local authentication.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/open_outline"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/open_outline"
DATABASE_SCHEMA="public"

# PostgreSQL transport: loopback URLs default to plaintext; remote URLs default
# to certificate and hostname verification. Use these only for a custom policy.
# POSTGRES_SSL_MODE="verify-full"
# POSTGRES_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"


# Optional aliases for an OpenOak deployment with a dedicated Outline database.
# OUTLINE_DATABASE_URL="postgresql://...outline-app-db..."
# OUTLINE_DIRECT_URL="postgresql://...outline-app-db-direct..."
# OUTLINE_DATABASE_SCHEMA="public"

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Optional OpenOak shared-auth mode. Leave these unset for a standalone install.
# ACCOUNT_DATABASE_URL="postgresql://...openoak-account-db..."
# ACCOUNT_DATABASE_SCHEMA="public"
# AUTH_COOKIE_DOMAIN=".openoak.org"
# NEXT_PUBLIC_ACCOUNT_URL="https://account.openoak.org"

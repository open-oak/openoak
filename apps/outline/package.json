{
  "name": "@openoak/outline",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "exports": {
    "./mcp": "./lib/mcp.ts"
  },
  "scripts": {
    "dev": "next dev",
    "postinstall": "prisma generate && prisma generate --schema prisma/central.prisma",
    "generate": "prisma generate && prisma generate --schema prisma/central.prisma",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "build": "prisma generate && prisma generate --schema prisma/central.prisma && next build",
    "build:vercel": "node ../../scripts/vercel-build.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@tiptap/extension-placeholder": "3.33.1",
    "@tiptap/extension-task-item": "3.33.1",
    "@tiptap/extension-task-list": "3.33.1",
    "@tiptap/extension-underline": "3.33.1",
    "@tiptap/html": "3.33.1",
    "@tiptap/markdown": "3.33.1",
    "@tiptap/react": "3.33.1",
    "@tiptap/starter-kit": "3.33.1",
    "better-auth": "1.7.19",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "next": "16.4.6",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "^3.5.0",
    "@tiptap/core": "3.33.1",
    "@tiptap/pm": "3.33.1",
    "@tiptap/extensions": "3.33.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prisma": "7.9.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  },
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/open_oak_account"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/open_oak_account"
DATABASE_SCHEMA="public"

# PostgreSQL transport: loopback URLs default to plaintext; remote URLs default
# to certificate and hostname verification. Use these only for a custom policy.
# POSTGRES_SSL_MODE="verify-full"
# POSTGRES_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
MCP_RESOURCE_URL="https://mcp.openoak.org"

# Set to ".openoak.org" in production so account.openoak.org sessions work on app subdomains.
AUTH_COOKIE_DOMAIN=""

# When set, this host list overrides the redirect origins derived from the suite URLs.
# AUTH_REDIRECT_HOSTS="openoak.org,account.openoak.org,todo.openoak.org,outline.openoak.org,notes.openoak.org,kanban.openoak.org"

# Local testing only: "log" prints verification and reset links to the server log (development mode).
# EMAIL_TRANSPORT="log"
RESEND_API_KEY=""
RESEND_FROM="OpenOak <noreply@openoak.org>"

# Vercel Cron sends this as a bearer token to /api/cron/cleanup-unverified.
# Self-hosted installs call that route daily with the same header.
CRON_SECRET=""

# Vercel BotID runs automatically on Vercel. Set "false" to turn it off there,
# or "true" to force it on behind another Vercel-compatible proxy.
# BOTID_ENABLED=""

# Custom shared-suite URLs (set these together on custom installations).
# OPENOAK_HOME_URL="https://example.org"
# OPENOAK_ACCOUNT_URL="https://account.example.org"
# OPENOAK_TODO_URL="https://todo.example.org"
# OPENOAK_OUTLINE_URL="https://outline.example.org"
# OPENOAK_KANBAN_URL="https://kanban.example.org"
# MCP_RESOURCE_URL="https://mcp.example.org"
# AUTH_COOKIE_PREFIX="openoak"
# Enable only after privacy:install-links succeeds on the same database.
# ACCOUNT_DELETION_SCHEMAS='{"account":"auth","todo":"todo","outline":"outline","kanban":"kanban"}'

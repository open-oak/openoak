# Required: one PostgreSQL database for app data and local authentication.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/open_todo"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/open_todo"
DATABASE_SCHEMA="public"

# PostgreSQL transport: loopback URLs default to plaintext; remote URLs default
# to certificate and hostname verification. Use these only for a custom policy.
# POSTGRES_SSL_MODE="verify-full"
# POSTGRES_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"


# Optional aliases for an OpenOak deployment with a dedicated Todo database.
# TODO_DATABASE_URL="postgresql://...todo-app-db..."
# TODO_DIRECT_URL="postgresql://...todo-app-db-direct..."
# TODO_DATABASE_SCHEMA="public"

# This also signs list invite links. Changing it invalidates all outstanding links.
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Optional OpenOak shared-auth mode. Leave these unset for a standalone install.
# ACCOUNT_DATABASE_URL="postgresql://...openoak-account-db..."
# ACCOUNT_DATABASE_SCHEMA="public"
# AUTH_COOKIE_DOMAIN=".openoak.org"
# NEXT_PUBLIC_ACCOUNT_URL="https://account.openoak.org"
